#!/bin/sh

set -u

usage() {
	cat <<'EOF'
Usage: dwr921-at-probe [tty-device ...]

Probe one modem AT port at a time with bounded, read-only commands.
Default devices: /dev/ttyUSB0 through /dev/ttyUSB3
Exit an interactive microcom session with Ctrl-X.
EOF
}

sanitize() {
	sed -E \
		-e 's/(IMEI|IMSI|ICCID|MSISDN|SERIAL|PHONE)([^[:alnum:]]*)[^[:space:]]+/\1\2[REDACTED]/g' \
		-e 's/[0-9]{10,20}/[REDACTED]/g'
}

case "${1:-}" in
	-h|--help)
		usage
		exit 0
		;;
esac

if ! command -v microcom >/dev/null 2>&1 || \
	! command -v stty >/dev/null 2>&1 || \
	! command -v timeout >/dev/null 2>&1; then
	echo "dwr921-at-probe: microcom, stty, and timeout are required" >&2
	exit 1
fi

if [ "$#" -gt 0 ]; then
	devices="$*"
else
	devices="/dev/ttyUSB0 /dev/ttyUSB1 /dev/ttyUSB2 /dev/ttyUSB3"
fi

tmp_output="/tmp/dwr921-at-probe.$$"
trap 'rm -f "$tmp_output"' EXIT INT TERM

for device in $devices; do
	echo "=== $device ==="
	if [ ! -c "$device" ]; then
		echo "status=missing"
		continue
	fi

	# The BM806C option driver rejects baud-rate ioctls, but accepts the
	# termios mode flags. USB modem serial links do not use a physical UART
	# baud clock, so configure the accepted raw/no-echo mode and let microcom
	# perform its own bounded open.
	if stty -F "$device" raw -echo 2>&1; then
		echo "stty=raw-no-echo (baud ioctl unsupported by USB modem driver)"
	else
		echo "stty=configuration-failed"
	fi

	printf '%s\n' 'commands=AT,ATI,AT+CGMI,AT+CGMM,AT+CGMR,AT+CPIN?,AT+CFUN?,AT+CSQ,AT+COPS?'
	{
		printf 'AT\rATI\rAT+CGMI\rAT+CGMM\rAT+CGMR\rAT+CPIN?\rAT+CFUN?\rAT+CSQ\rAT+COPS?\r'
		sleep 2
	} | timeout -k 1 8 microcom -s 115200 -t 3000 "$device" >"$tmp_output" 2>&1
	result=$?
	sanitize <"$tmp_output"
	if grep -Eiq '(^|[^[:alpha:]])(OK|ERROR|READY|BroadMobi|BM806C)([^[:alpha:]]|$)' "$tmp_output"; then
		echo "response=present"
	else
		echo "response=silent-or-unrecognized"
	fi
	echo "microcom_timeout_or_exit=$result"
done
