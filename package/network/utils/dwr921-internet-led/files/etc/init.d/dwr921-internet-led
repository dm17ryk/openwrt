#!/bin/sh /etc/rc.common

START=97
USE_PROCD=1

PROG=/usr/sbin/dwr921-internet-led
LED=/sys/class/leds/green:internet

. /lib/functions.sh

start_service() {
	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = \
		dlink,dwr-921-c3-uboot ] || return 0

	config_load dwr921-internet-led
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 10 3
	procd_close_instance
}

stop_service() {
	echo none > "$LED/trigger" 2>/dev/null || true
	echo 0 > "$LED/brightness" 2>/dev/null || true
}

service_triggers() {
	procd_add_reload_trigger dwr921-internet-led
}
