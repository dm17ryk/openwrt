+		while (remaining >= 3) {
+			uint8_t type = tlv_data[0];
+			uint16_t len = dwr921_trace_le16(tlv_data + 1);
+			dwr921_trace_prefix();
+			fprintf(stderr, "dir=%s service=0x00 transaction=0x%02x message=0x%04x "
+				"tlv_type=0x%02x tlv_len=%u qmi_result=",
+				direction, transaction, message, type, len);
+			if ((size_t)len > remaining - 3) {
