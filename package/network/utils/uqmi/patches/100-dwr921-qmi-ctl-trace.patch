+		declared_qmux_len,
+		frame_len >= DWR921_TRACE_MARKER + 1 ? "0x" : "na", marker,
+		frame_len >= DWR921_TRACE_QMUX_FLAGS + 1 ? "0x" : "na", qmux_flags,
+		frame_len >= DWR921_TRACE_SERVICE + 1 ? "0x" : "na", service,
+		frame_len >= DWR921_TRACE_CLIENT + 1 ? "0x" : "na", client,
+		frame_len >= DWR921_TRACE_CTL_FLAGS + 1 ? "0x" : "na", ctl_flags,
+		frame_len >= DWR921_TRACE_CTL_TRANSACTION + 1 ? "0x" : "na", transaction,
+		frame_len >= DWR921_TRACE_CTL_MESSAGE + 2 ? "" : "na", message,
+		frame_len >= DWR921_TRACE_CTL_TLV_LEN + 2 ? "" : "na", tlv_len,
+		length_reason);
+
+	if (frame_len < DWR921_TRACE_CTL_HEADER || service != QMI_SERVICE_CTL)
+		return;
+	if (marker != 1 && !strcmp(length_reason, "received"))
+		return;
+	if (!declared_frame_len || declared_frame_len > frame_len) {
+		dwr921_trace_prefix();
+		fprintf(stderr, "reason=truncated-frame declared_frame_len=%zu available=%zu\n",
+			declared_frame_len, frame_len);
+		return;
+	}
+	if (declared_frame_len < DWR921_TRACE_CTL_HEADER) {
+		dwr921_trace_prefix();
+		fprintf(stderr, "reason=qmux-length-too-short declared_frame_len=%zu minimum=%u\n",
+			declared_frame_len, DWR921_TRACE_CTL_HEADER);
+		return;
+	}
+	if (marker != 1) {
+		dwr921_trace_prefix();
+		fprintf(stderr, "reason=unexpected-qmux-marker observed=0x%02x expected=0x01\n",
+			marker);
+		return;
+	}
+
+	if ((ctl_flags & QMI_CTL_FLAG_RESPONSE) &&
+	    (ctl_flags & QMI_CTL_FLAG_INDICATION)) {
+		length_reason = "unexpected-ctl-flags";
+	}
+
+	if (tlv_len > actual_len - DWR921_TRACE_CTL_TLV) {
+		dwr921_trace_prefix();
+		fprintf(stderr, "reason=truncated-tlv-area declared_tlv_len=%u available=%zu\n",
+			tlv_len, actual_len - DWR921_TRACE_CTL_TLV);
+		tlv_len = actual_len - DWR921_TRACE_CTL_TLV;
+	}
+
+	if (tlv_len) {
+		const uint8_t *tlv_data = data + DWR921_TRACE_CTL_TLV;
+		size_t remaining = tlv_len;
