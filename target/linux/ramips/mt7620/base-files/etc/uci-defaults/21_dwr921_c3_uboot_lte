#!/bin/sh
#
# config_generate only copies device/macaddr/metric/protocol/ipaddr/netmask/vlan
# out of board.json, and its ncm|qmi|mbim branch hardcodes proto and pdptype.
# Every other option set by ucidef_set_interface -- apn, auth, mtu, autoconnect
# -- is silently dropped, so the lte defaults have to be applied here instead.
#
# autoconnect stays OFF. Enabling it writes WDS 0x51 into the modem's NVRAM, the
# modem then raises the PDN itself, the host's own network-start request answers
# "No effect", and no host WDS client ever owns a packet data handle -- downlink
# is then zero. With it off the host owns the bearer, exactly as the stock
# firmware does, and ifstatus reports a real numeric pdh_4.
#
# mtu 1420 is the value the carrier specifies for this APN.
#
# dhcp is left UNSET so qmi.sh spawns its dynamic <iface>_4 DHCP client. The
# BM806C is itself the DHCP server on the 802.3 link and only starts delivering
# downlink once a DHCP exchange has bound the host's MAC; a purely static
# address suppresses that and the modem answers neither ARP nor IP traffic.

case "$(board_name)" in
	dlink,dwr-921-c3-uboot)
		[ -n "$(uci -q get network.lte)" ] || exit 0

		uci -q batch <<-EOF
			set network.lte.apn='uinternet'
			set network.lte.auth='none'
			set network.lte.autoconnect='0'
			set network.lte.mtu='1420'
			delete network.lte.dhcp
		EOF
		uci commit network
		;;
esac

exit 0
